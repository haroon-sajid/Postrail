# Production build variables for the dashboard. Nothing here is secret: every value is
# baked into the public JavaScript bundle.
#
# Cloudflare must have this as a BUILD variable (Workers & Pages > postrail > Settings >
# Variables and Secrets, or "Build" > "Variables") for both production and preview
# builds. Vite reads it at `vite build` time, so changing it in Cloudflare does nothing
# until the next build. See docs/deploy.md.

VITE_API_URL=https://postrail-api.onrender.com
