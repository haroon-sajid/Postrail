# Copy to apps/web/.env for local development. Vite reads only VITE_-prefixed variables
# and bakes them into the bundle at build time; they are not read at runtime.

# Absolute URL of the Postrail API, no trailing slash. Optional.
# Unset: http://localhost:8080 when the page runs on localhost, otherwise the page's own
# origin (the Cloudflare Worker proxies API paths there). Set it only to point a dev
# server at another API.
VITE_API_URL=http://localhost:8080
