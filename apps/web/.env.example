# Copy to apps/web/.env for local development. Vite reads only VITE_-prefixed variables
# and bakes them into the bundle at build time; they are not read at runtime.

# Absolute URL of the Postrail API, no trailing slash.
# Optional on localhost (defaults to http://localhost:8080). Required for any build that
# will be served from another host; the app throws at startup if it is missing.
VITE_API_URL=http://localhost:8080
