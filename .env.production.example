# Production values are NOT stored in files, in this repo or on any laptop.
# This file only documents what the Cloud Run service needs. The real values go into
# GCP Secret Manager and are mounted into Cloud Run as environment variables.

# Neon production branch (main). Secret Manager name suggestion: postrail-database-url
DATABASE_URL=<from GCP Secret Manager>

# Secret Manager name suggestion: postrail-token-encryption-key (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=<from GCP Secret Manager>

# Production OAuth client. Secret Manager: postrail-google-client-id / -client-secret
GOOGLE_CLIENT_ID=<from GCP Secret Manager>
GOOGLE_CLIENT_SECRET=<from GCP Secret Manager>
# Through the dashboard's Worker proxy, so Google only ever sees the dashboard host.
GOOGLE_REDIRECT_URI=https://postrail.haroonsajid-ai.workers.dev/api/google/callback

NODE_ENV=production
LOG_LEVEL=info

# Session signing secret. Secret Manager / Render secret: postrail-better-auth-secret
BETTER_AUTH_SECRET=<secret, openssl rand -hex 32>

# Public origins (docs/deploy.md). The API runs on Render but users reach it through the
# dashboard's Cloudflare Worker, which proxies /api, /v1, /app, /openapi.json, /docs and
# /health. So both origins are the dashboard, cookies are first-party and CORS is off.
API_ORIGIN=https://postrail.haroonsajid-ai.workers.dev
DASHBOARD_ORIGIN=https://postrail.haroonsajid-ai.workers.dev
# Preview builds get their own hostnames; trust them for the CSRF check and sign-in.
CORS_ORIGIN_PATTERN=https://*-postrail.haroonsajid-ai.workers.dev
# CORS_ORIGIN is not needed: nothing calls the API cross-origin in production.
# Connected mailbox that sends magic links and invites.
SYSTEM_MAILBOX_EMAIL=noreply@your-domain.example

# Delivery through Google Cloud Tasks. The API is both the enqueuer and the worker.
QUEUE_DRIVER=cloudtasks
GCP_PROJECT_ID=<gcp project id>
GCP_REGION=<cloud run / cloud tasks region, e.g. us-central1>
TASKS_QUEUE_NAME=send-email
# Full URL of the worker endpoint on the deployed API. Also the OIDC audience.
WORKER_URL=https://api.postrail.example/internal/tasks/send-email
# Service account Cloud Tasks and Cloud Scheduler sign OIDC tokens as.
# Needs roles/run.invoker on the API service; the API's own SA needs roles/cloudtasks.enqueuer
# and roles/iam.serviceAccountUser on it.
TASKS_SERVICE_ACCOUNT_EMAIL=postrail-tasks@<project>.iam.gserviceaccount.com
# INTERNAL_SECRET is not used with cloudtasks; OIDC replaces it.
#
# Cloud Scheduler job (00:00 UTC): POST https://api.postrail.example/internal/cron/reset-daily-counters
# with an OIDC token for TASKS_SERVICE_ACCOUNT_EMAIL and audience set to that same URL.

# PORT is injected by Cloud Run.
# APP_VERSION is set by the deploy pipeline to the git SHA being deployed.
